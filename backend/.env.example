# KalaGanaka Backend Environment Configuration

# Backend server
HOST=127.0.0.1
PORT=8000

# Optional custom directory for JPL DE421 ephemeris storage
# Defaults to backend/data/ephemeris
# KALAGANAKA_EPHEMERIS_DIR=./data/ephemeris

# AI provider configuration
XAI_API_KEY=
XAI_MODEL=grok-4.7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash